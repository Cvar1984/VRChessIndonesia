{% extends 'base.html.twig' %}

{% block title %}Newsletter — VRChess Indonesia{% endblock %}

{% block head_meta %}
    <meta name="description" content="News and announcements from the VRChess Indonesia community group.">
    <meta name="robots" content="index, follow">
{% endblock %}

{% block javascripts %}{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/theme-8bit.css') }}">
        <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        <style>
            .post-card {
                background: var(--bg-card);
                border: 2px solid var(--border-subtle);
                padding: 18px;
                margin-bottom: 20px;
            }

            .post-card__header {
                display: flex;
                align-items: baseline;
                justify-content: space-between;
                gap: 12px;
                flex-wrap: wrap;
                margin-bottom: 10px;
            }

            .post-card__title {
                font-family: var(--font-display);
                font-size: 0.75rem;
                color: var(--accent-primary);
                line-height: 1.6;
            }

            .post-card__date {
                font-size: 0.8rem;
                color: var(--text-muted);
                white-space: nowrap;
            }

            .post-card__image {
                /* Admin-uploaded post images can be any shape — screenshots,
                   portrait memes, banners — so this never crops. Full image,
                   scaled to fit the card width at its own natural ratio. */
                width: 100%;
                height: auto;
                display: block;
                margin-bottom: 12px;
                border: 1px solid var(--border-subtle);
            }

            .post-card__text {
                font-size: 0.95rem;
                color: var(--text-secondary);
                white-space: pre-wrap;
                line-height: 1.6;
            }
        </style>
{% endblock %}

{% block body %}
        <div class="app-wrapper">

            <header class="app-header">
                <div class="hero-banner">
                    <img src="{{ asset('images/gallery/banner-wide.jpg') }}" alt="VRChess Indonesia">
                </div>
                <div class="app-header__logo">
                    <div class="app-header__icon"><img src="{{ asset('images/gallery/logo.png') }}" alt=""></div>
                    <div>
                        <h1 class="app-header__title">Newsletter</h1>
                        <p class="app-header__subtitle">News and announcements from the group</p>
                    </div>
                </div>
            </header>

            {% include '_nav.html.twig' %}

            {% if posts is empty %}
                <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:16px;">
                    No public posts from the VRChat group yet — check back soon.
                </p>
            {% else %}
                <section>
                    {% for post in posts %}
                        <article class="post-card">
                            <div class="post-card__header">
                                <h2 class="post-card__title">{{ post.title|upper }}</h2>
                                <time class="post-card__date">{{ post.createdAt|date('d M Y') }}</time>
                            </div>
                            {% if post.imageUrl %}
                                <img class="post-card__image" src="{{ path('newsletter_image', {postId: post.id}) }}" alt="{{ post.title }}" loading="lazy">
                            {% endif %}
                            <p class="post-card__text">{{ post.text }}</p>
                        </article>
                    {% endfor %}
                </section>
            {% endif %}

            <!-- ── Footer ── -->
            <footer class="app-footer">
                <div class="app-footer__main">
                    <span class="app-footer__brand">VRChess Indonesia</span>
                    <span class="app-footer__sep">&copy; 2026</span>
                    <span class="app-footer__sep hide-mobile">&middot;</span>
                    <span class="app-footer__tagline">Built with &hearts; for the Indonesian Chess Community</span>
                </div>
                <div class="app-footer__links">
                    <a class="app-footer__link" href="https://github.com/Cvar1984/VRChessIndonesia" target="_blank"
                        rel="noopener">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path
                                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                        </svg>
                        <span>GitHub</span>
                    </a>
                </div>
            </footer>

        </div>
{% endblock %}
