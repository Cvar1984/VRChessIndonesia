<!DOCTYPE html>
<html lang="id">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <!-- ── Basic Meta Tags ── -->
        <title>VRChess Indonesia — Peringkat Catur &amp; Admin Panel</title>
        <meta name="description"
            content="VRChess Indonesia — Platform peringkat dan manajemen pertandingan catur VR untuk komunitas Indonesia. Lacak rating, riwayat pertandingan, dan kelola API token.">
        <meta name="keywords" content="catur, chess, VR, Indonesia, rating, peringkat, turnamen, API tokens">
        <meta name="author" content="VRChess Indonesia">
        <meta name="robots" content="index, follow">
        <link rel="canonical" href="https://chess.cvar1984.net/">

        <!-- ── Open Graph / Facebook ── -->
        <meta property="og:type" content="website">
        <meta property="og:url" content="https://chess.cvar1984.net/">
        <meta property="og:title" content="VRChess Indonesia — Peringkat Catur &amp; API Token Management">
        <meta property="og:description"
            content="Platform peringkat dan manajemen pertandingan catur VR untuk komunitas Indonesia. Lacak rating, riwayat pertandingan, dan kelola API token.">
        <meta property="og:image" content="https://chess.cvar1984.net/thumbnail.png">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="VRChess Indonesia - Platform Peringkat Catur">
        <meta property="og:site_name" content="VRChess Indonesia">
        <meta property="og:locale" content="id_ID">

        <!-- ── Twitter Card ── -->
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:url" content="https://chess.cvar1984.net/">
        <meta name="twitter:title" content="VRChess Indonesia — Peringkat Catur &amp; API Token Management">
        <meta name="twitter:description"
            content="Platform peringkat dan manajemen pertandingan catur VR untuk komunitas Indonesia.">
        <meta name="twitter:image" content="https://chess.cvar1984.net/thumbnail.png">
        <meta name="twitter:image:alt" content="VRChess Indonesia - Platform Peringkat Catur">

        <!-- ── Favicon ── -->
        <link rel="icon" type="image/svg+xml"
            href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='80' font-size='80'>♚</text></svg>">

        <!-- ── Chess libraries ── -->
        <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
        <link rel="stylesheet" href="https://unpkg.com/chessground/assets/chessground.base.css">
        <link rel="stylesheet" href="https://unpkg.com/chessground/assets/chessground.brown.css">
        <link rel="stylesheet" href="https://unpkg.com/chessground/assets/chessground.cburnett.css">
        <script type="module">
            import { Chessground } from 'https://unpkg.com/chessground/dist/chessground.js';
            window.Chessground = Chessground;
        </script>

        <!-- ── In-browser Stockfish (lichess-org/stockfish-web), default analysis engine ──
             Falls back to /api/engine/analyze (native Stockfish on the server) when the browser
             can't run the threaded WASM build — see assets/engine/vrchess-engine.js. -->
        <script type="module">
            import { getSession } from '{{ asset('engine/vrchess-engine.js') }}';

            window.VRChessEngine = {
                async isAvailable() {
                    try {
                        return !!(await getSession());
                    } catch (e) {
                        console.warn('[VRChessEngine] unavailable:', e);
                        return false;
                    }
                },
                async analyze(fen, opts, onUpdate, signal) {
                    const session = await getSession();
                    if (!session) throw new Error('Client engine unavailable');
                    return session.analyze(fen, opts, onUpdate, signal);
                },
            };
        </script>

        <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        <style>
            /* Base fixes for chessground */
            .cg-wrap {
                width: 100%;
                height: 100%;
                display: block;
            }

            #analysisBoard {
                aspect-ratio: 1 / 1;
            }

            /* Hide any piece clone that leaked outside of a drag gesture */
            body:not(.piece-dragging)>img[data-piece] {
                display: none !important;
            }

            .auth-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 4px 14px;
                border-radius: 20px;
                font-size: 0.72rem;
                font-weight: 700;
                letter-spacing: 0.5px;
                text-transform: uppercase;
                transition: all var(--transition-normal);
            }

            .auth-badge--admin {
                background: linear-gradient(135deg, rgba(124, 92, 255, 0.25), rgba(92, 225, 230, 0.15));
                color: var(--accent-secondary);
                border: 1px solid var(--accent-primary);
                box-shadow: 0 0 12px rgba(124, 92, 255, 0.2);
            }

            .admin-only {
                display: none !important;
            }

            body.is-admin .admin-only {
                display: inline-flex !important;
            }

            body.is-admin div.admin-only,
            body.is-admin section.admin-only,
            body.is-admin button.admin-only,
            body.is-admin table.admin-only {
                display: flex !important;
            }

            body.is-admin .admin-only-block {
                display: block !important;
            }

            body:not(.is-admin) .visitor-only {
                display: inline-flex !important;
            }

            body.is-admin .visitor-only {
                display: none !important;
            }

            .match-actions-btn {
                opacity: 0.8;
                transition: all 0.2s ease;
            }

            .match-actions-btn:hover {
                opacity: 1;
                transform: scale(1.05);
            }

            .admin-banner {
                background: linear-gradient(135deg, rgba(124, 92, 255, 0.15), rgba(92, 225, 230, 0.08));
                border: 1px solid rgba(124, 92, 255, 0.3);
                border-radius: var(--radius-lg);
                padding: 12px 20px;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                font-size: 0.85rem;
            }

            .token-code {
                font-family: var(--font-mono);
                background: rgba(0, 0, 0, 0.4);
                padding: 4px 8px;
                border-radius: 4px;
                border: 1px solid var(--border-subtle);
                font-size: 0.78rem;
                color: var(--accent-secondary);
                word-break: break-all;
            }
        </style>
    </head>

    <body>

        <div class="app-wrapper">

            <!-- ── Header ── -->
            <header class="app-header">
                <div class="app-header__logo">
                    <div class="app-header__icon">♚</div>
                    <div>
                        <h1 class="app-header__title">VRChess Indonesia</h1>
                        <p class="app-header__subtitle">Rating &amp; Match Management System</p>
                    </div>
                </div>
                <div class="app-header__actions">
                    <span id="authBadge" class="auth-badge admin-only"></span>
                    <button class="btn btn--primary btn--sm visitor-only" id="btnOpenLoginModal" type="button">🔑 Admin
                        Login</button>
                    <button class="btn btn--secondary btn--sm admin-only" id="btnLogoutBtn" type="button">🚪
                        Logout</button>
                </div>
            </header>

            <!-- ── Admin Status Banner ── -->
            <div class="admin-banner admin-only" id="adminBanner">
                <div style="display:flex; align-items:center; gap:10px;">
                    <span style="font-size:1.2rem;">👑</span>
                    <span><strong>Mode Admin Aktif (<span id="currentAdminName"></span>)</strong> — Penuh kontrol:
                        kelola Users Admin, API Tokens, catat &amp; edit pertandingan.</span>
                </div>
            </div>

            <!-- ── Connection Status ── -->
            <div class="connection-bar" id="connectionBar">
                <span class="connection-bar__dot" id="statusDot"></span>
                <span id="statusText">Menghubungkan ke server…</span>
            </div>

            <!-- ── Tab Navigation ── -->
            <nav class="tab-nav" id="tabNav">
                <button class="tab-btn active" data-tab="leaderboard" id="tabBtnLeaderboard">
                    <span class="tab-btn__icon">🏆</span>
                    <span class="tab-btn__label">Leaderboard</span>
                    <span class="tab-btn__count" id="playerCount">0</span>
                </button>
                <button class="tab-btn" data-tab="matches" id="tabBtnMatches">
                    <span class="tab-btn__icon">⚔</span>
                    <span class="tab-btn__label">Match History</span>
                    <span class="tab-btn__count" id="matchCount">0</span>
                </button>
                <button class="tab-btn admin-only" data-tab="play" id="tabBtnPlay">
                    <span class="tab-btn__icon">🎮</span>
                    <span class="tab-btn__label">Submit Match</span>
                </button>
                <button class="tab-btn admin-only" data-tab="admin" id="tabBtnAdmin">
                    <span class="tab-btn__icon">⚙</span>
                    <span class="tab-btn__label">Admin Panel</span>
                </button>
                <button class="tab-btn" data-tab="analysis" id="tabBtnAnalysis">
                    <span class="tab-btn__icon">🧠</span>
                    <span class="tab-btn__label">Analisis (Stockfish)</span>
                </button>
                <button class="tab-btn" data-tab="analyses-history" id="tabBtnAnalysesHistory">
                    <span class="tab-btn__icon">📚</span>
                    <span class="tab-btn__label">Daftar Analisis</span>
                    <span class="tab-btn__count" id="analysisCount">0</span>
                </button>
            </nav>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- TAB 1: Leaderboard                                      -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <section class="tab-content active" id="tab-leaderboard">
                <div class="card">
                    <div class="card__header">
                        <div class="card__title">🏆 Player Rankings</div>
                        <div style="display:flex; gap:8px;">
                            <button class="btn btn--primary btn--sm admin-only" id="btnAddPlayerBtn" type="button">➕
                                Tambah Pemain</button>
                            <button class="btn btn--secondary btn--sm admin-only" id="btnRefreshVrchatAvatars"
                                title="Segarkan foto profil VRChat" type="button">🔄 Avatar VRChat</button>
                            <button class="btn btn--secondary btn--sm" id="btnRefreshPlayers"
                                title="Refresh leaderboard" type="button">↻ Refresh</button>
                        </div>
                    </div>

                    <div class="search-wrapper">
                        <span class="search-wrapper__icon">🔍</span>
                        <input type="text" class="search-input" id="playerSearch" placeholder="Cari pemain...">
                    </div>

                    <div id="leaderboardContainer">
                        <div class="empty-state">
                            <div class="empty-state__icon">♟</div>
                            <div class="empty-state__text">Belum ada pemain</div>
                            <div class="empty-state__sub">Pertandingan pertama akan otomatis mendaftarkan pemain</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- TAB 2: Match History                                    -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <section class="tab-content" id="tab-matches">
                <div class="card">
                    <div class="card__header">
                        <div class="card__title">⚔ Match History</div>
                        <button class="btn btn--secondary btn--sm" id="btnRefreshMatches" title="Refresh matches"
                            type="button">↻ Refresh</button>
                    </div>

                    <!-- Match Filters -->
                    <datalist id="playerNamesList"></datalist>
                    <div style="display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap;">
                        <div class="search-wrapper" style="flex: 1; min-width: 140px; margin-bottom: 0;">
                            <span class="search-wrapper__icon" style="font-size: 0.9rem;">🔍</span>
                            <input type="text" class="search-input" id="matchSearch"
                                placeholder="Cari (nama, w:nama, b:nama, y:2026, m:8, d:15)..." list="playerNamesList"
                                autocomplete="off"
                                title="Filter: w:nama (putih), b:nama (hitam), y:YYYY (tahun), m:MM (bulan), d:DD (hari)">
                        </div>
                        <button class="btn btn--secondary" id="btnResetMatchFilters"
                            style="padding: 0 16px;">Reset</button>
                    </div>
                    <div class="filter-bar">
                        <button class="filter-btn active" data-filter="all" id="filterAllMatches">Semua
                            Pertandingan</button>
                        <button class="filter-btn" data-filter="valid" id="filterValidMatches">✅ Valid</button>
                        <button class="filter-btn" data-filter="invalid" id="filterInvalidMatches">🚫
                            Invalidated</button>
                    </div>

                    <div id="matchesContainer">
                        <div class="empty-state">
                            <div class="empty-state__icon">📋</div>
                            <div class="empty-state__text">Belum ada riwayat pertandingan</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- TAB 3: Submit Match (Admin Only)                       -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <section class="tab-content" id="tab-play">
                <div class="card">
                    <div class="card__header">
                        <div class="card__title">🎮 Catat Pertandingan Baru</div>
                        <span class="card__badge card__badge--purple">ADMIN ACTION</span>
                    </div>

                    <form id="playMatchForm">
                        <div class="form-row">
                            <div class="form-group autocomplete-wrapper">
                                <label class="form-label" for="playWhite">Pemain Putih (White)</label>
                                <input type="text" class="form-input" id="playWhite" placeholder="Ketik nama pemain..."
                                    required autocomplete="off">
                            </div>
                            <div class="form-group autocomplete-wrapper">
                                <label class="form-label" for="playBlack">Pemain Hitam (Black)</label>
                                <input type="text" class="form-input" id="playBlack" placeholder="Ketik nama pemain..."
                                    required autocomplete="off">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="playResult">🏆 Hasil Pertandingan</label>
                            <select class="form-select" id="playResult" required>
                                <option value="1">1 - 0 (White Menang)</option>
                                <option value="0">½ - ½ (Draw / Seri)</option>
                                <option value="-1">0 - 1 (Black Menang)</option>
                            </select>
                        </div>

                        <!-- PGN is the primary option — saved automatically on submit -->
                        <div class="form-group">
                            <label class="form-label">📄 Upload PGN <span
                                    style="font-weight:400;color:var(--text-secondary);">(Diutamakan)</span></label>
                            <p style="font-size:0.78rem; color:var(--text-secondary); margin-bottom:8px;">
                                PGN akan disimpan otomatis sebagai analisis saat pertandingan dicatat.
                                Jika tidak ada PGN, gunakan URL di bawah sebagai gantinya.
                            </p>
                            <textarea class="form-input" id="playPgn" rows="5"
                                placeholder="[Event &#34;?&#34;]&#10;[White &#34;Player1&#34;]&#10;[Black &#34;Player2&#34;]&#10;&#10;1. e4 e5 ..."
                                style="font-family: var(--font-mono); font-size: 0.78rem; resize: vertical;"></textarea>
                            <div style="display:flex; gap:8px; margin-top:6px; align-items:center;">
                                <label class="btn btn--secondary btn--sm" style="cursor:pointer; margin:0;"
                                    for="playPgnFile">📂 Buka File PGN</label>
                                <input type="file" id="playPgnFile" accept=".pgn" style="display:none;">
                                <button type="button" class="btn btn--secondary btn--sm" id="btnClearPlayPgn">✕
                                    Hapus</button>
                            </div>
                        </div>

                        <!-- URL fallback — only used if no PGN is provided -->
                        <div class="form-group">
                            <label class="form-label" for="playUrl">🔗 URL Analisis Eksternal <span
                                    style="font-weight:400;color:var(--text-secondary);">(Opsional, diabaikan jika PGN
                                    diisi)</span></label>
                            <input type="text" class="form-input" id="playUrl"
                                placeholder="https://www.chessigma.com/games/...">
                        </div>

                        <button type="submit" class="btn btn--primary btn--full" id="btnSubmitMatch">
                            ⚡ Catat Pertandingan &amp; Hitung Ulang Rating
                        </button>
                    </form>

                    <!-- Match Result Reveal -->
                    <div class="result-panel" id="playResultPanel" style="display:none;">
                        <div class="result-panel__title">🎉 Pertandingan Berhasil Dicatat!</div>
                        <div class="result-panel__grid">
                            <div class="result-player">
                                <div class="result-player__name" id="resWhiteName">White</div>
                                <div class="result-player__rating">
                                    <span id="resWhiteOld">400</span> ➔ <strong id="resWhiteNew">430</strong>
                                    <span class="result-player__change positive" id="resWhiteChange">+30</span>
                                </div>
                            </div>
                            <div class="result-player">
                                <div class="result-player__name" id="resBlackName">Black</div>
                                <div class="result-player__rating">
                                    <span id="resBlackOld">400</span> ➔ <strong id="resBlackNew">395</strong>
                                    <span class="result-player__change negative" id="resBlackChange">-5</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- TAB 4: Admin Panel (Tokens & Admins)                    -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <section class="tab-content" id="tab-admin">
                <div class="card">
                    <div class="card__header">
                        <div class="card__title">⚙ Dashboard Kontrol Admin</div>
                        <span class="card__badge card__badge--green">SYSTEM CONTROL</span>
                    </div>

                    <div class="stats-overview-grid">
                        <div class="stat-box">
                            <div class="stat-box__val" id="adminStatPlayers">0</div>
                            <div class="stat-box__lbl">Total Pemain</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-box__val" id="adminStatMatches">0</div>
                            <div class="stat-box__lbl">Total Pertandingan</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-box__val" id="adminStatTokens">0</div>
                            <div class="stat-box__lbl">API Tokens</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-box__val" id="adminStatAdmins">0</div>
                            <div class="stat-box__lbl">User Admins</div>
                        </div>
                    </div>
                </div>

                <!-- Kelola Admin Users Card -->
                <div class="card">
                    <div class="card__header">
                        <div class="card__title">🛡️ Kelola User Admins</div>
                        <button class="btn btn--primary btn--sm" id="btnShowCreateAdminModal" type="button">➕ Tambah
                            Admin</button>
                    </div>
                    <p style="font-size:0.8rem; color:var(--text-secondary); margin-bottom:16px;">
                        Daftar pengguna dengan akses admin ke sistem VRChess Indonesia.
                    </p>

                    <div id="adminsContainer">
                        <div class="empty-state">
                            <div class="empty-state__icon">🛡️</div>
                            <div class="empty-state__text">Memuat Admin Users...</div>
                        </div>
                    </div>
                </div>

                <!-- API Tokens Management Card -->
                <div class="card">
                    <div class="card__header">
                        <div class="card__title">🔑 Kelola API Access Tokens</div>
                        <button class="btn btn--primary btn--sm" id="btnShowCreateTokenModal" type="button">➕ Buat Token
                            Baru</button>
                    </div>
                    <p style="font-size:0.8rem; color:var(--text-secondary); margin-bottom:16px;">
                        Setiap request API dapat diautentikasi menggunakan Header
                        <code>X-API-Token: &lt;token&gt;</code> atau <code>Authorization: Bearer &lt;token&gt;</code>.
                    </p>

                    <div id="tokensContainer">
                        <div class="empty-state">
                            <div class="empty-state__icon">🔑</div>
                            <div class="empty-state__text">Memuat API Tokens...</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- TAB 5: Stockfish Analysis                               -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <section class="tab-content" id="tab-analysis">

                <!-- Import PGN Card -->
                <div class="card" id="analysisPgnImportCard">
                    <div class="card__header">
                        <div class="card__title">🧠 Stockfish PGN Analysis</div>
                        <span class="card__badge card__badge--green">Powered by Stockfish 18</span>
                    </div>
                    <p style="font-size:0.82rem; color:var(--text-secondary); margin-bottom:14px;">
                        Import file PGN untuk menganalisis seluruh permainan dengan Stockfish. Setiap posisi akan
                        dievaluasi dan ditampilkan secara interaktif.
                    </p>
                    <div class="form-group">
                        <label class="form-label" for="pgnInput">Teks PGN</label>
                        <textarea class="form-input" id="pgnInput" rows="6"
                            placeholder="[Event &quot;?&quot;]&#10;[White &quot;Player1&quot;]&#10;[Black &quot;Player2&quot;]&#10;&#10;1. e4 e5 2. Nf3 ..."
                            style="font-family: var(--font-mono); font-size: 0.8rem; resize: vertical;"></textarea>
                    </div>
                    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                        <label class="btn btn--secondary btn--sm" style="cursor:pointer;" for="pgnFileInput">📂 Buka
                            File PGN</label>
                        <input type="file" id="pgnFileInput" accept=".pgn" style="display:none;">
                        <button class="btn btn--primary" id="btnStartPgnAnalysis" type="button">⚡ Mulai Analisis
                            PGN</button>
                        <button class="btn btn--secondary" id="btnStartFreeAnalysis" type="button">Mulai Kosong (Free
                            Play)</button>
                    </div>
                    <!-- Progress -->
                    <div id="analysisProgress" style="display:none; margin-top:16px;">
                        <div style="font-size:0.82rem; color:var(--text-secondary); margin-bottom:6px;">
                            Menganalisis posisi <span id="analysisCurrent">0</span> / <span id="analysisTotal">0</span>…
                            <span id="analysisEngineLabel" style="color:#7fa650; font-weight:600;"></span>
                        </div>
                        <div style="background:rgba(255,255,255,0.08); border-radius:6px; height:8px; overflow:hidden;">
                            <div id="analysisProgressBar"
                                style="width:0%; height:100%; background:linear-gradient(90deg, var(--accent-primary), var(--accent-secondary)); border-radius:6px; transition: width 0.3s ease;">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Analysis Layout (shown after import) -->
                <div id="analysisMainLayout" style="display:none; max-width: 1000px; margin: 0 auto;">

                    <style>
                        .btn-cc {
                            background: transparent;
                            border: none;
                            color: #b3b3b2;
                            padding: 10px 16px;
                            font-size: 1.2rem;
                            cursor: pointer;
                            transition: background 0.15s, color 0.15s;
                        }

                        .btn-cc:hover {
                            background: #363430;
                            color: #fff;
                        }

                        #moveListContainer table {
                            border-collapse: collapse;
                            width: 100%;
                            font-size: 0.85rem;
                        }

                        #moveListContainer tr {
                            border-bottom: 1px solid #33312e !important;
                            border-top: none !important;
                        }

                        #moveListContainer tr:nth-child(even) {
                            background: #2a2825;
                        }

                        #moveListContainer td {
                            padding: 0 !important;
                        }

                        .analysis-move-btn {
                            padding: 8px 12px !important;
                            border-radius: 0 !important;
                            font-weight: 700 !important;
                        }
                    </style>

                    <div class="chesscom-layout"
                        style="display:flex; gap:24px; flex-wrap:wrap; align-items:flex-start;">

                        <!-- Left: Board Area -->
                        <div class="board-column"
                            style="flex:1 1 450px; min-width:320px; max-width:600px; display:flex; flex-direction:column; gap:8px; position: sticky; top: 20px; z-index: 100;">

                            <!-- Player Top (Black by default — swaps with the bottom row when the
                                 board is flipped, see .board-column.flipped in style.css) -->
