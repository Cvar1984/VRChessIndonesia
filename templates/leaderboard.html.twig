                    </button>
                    <button class="modal-tab-btn" data-modal-tab="history" type="button">
                        <span class="tab-btn__icon">📜</span><span class="tab-btn__label">Riwayat</span>
                        <span class="tab-btn__count" id="modalHistoryCount">0</span>
                    </button>
                </div>

                <div class="modal-tab-content active" id="modalTabOverview">
                    <div class="stats-overview-grid">
                        <div class="stat-box">
                            <div class="stat-box__val" id="statGames">0</div>
                            <div class="stat-box__lbl">Main</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-box__val" id="statWinRate">0%</div>
                            <div class="stat-box__lbl">Win Rate</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-box__val" id="statRank">—</div>
                            <div class="stat-box__lbl">Peringkat</div>
                        </div>
                        <div class="stat-box" id="statAccuracyBox"
                            title="Rata-rata akurasi Stockfish dari game yang sudah dianalisis">
                            <div class="stat-box__val" id="statAvgAccuracy">—</div>
                            <div class="stat-box__lbl">Akurasi</div>
                        </div>
                        <div class="stat-box" id="statBrilliantBox"
                            title="Total langkah Brilliant dari game yang sudah dianalisis">
                            <div class="stat-box__val" id="statBrilliantCount">—</div>
                            <div class="stat-box__lbl">✨ Brilliant</div>
                        </div>
                    </div>
                    <div class="profile-meta-row">
                        <span id="statValidMatches">0 valid</span>
                        <span id="statInvalidMatches">0 dianulir</span>
                    </div>
                </div>

                <div class="modal-tab-content" id="modalTabHistory">
                    <div class="profile-history-list" id="profileHistoryList"></div>
                </div>

                <div class="modal-footer"
                    style="display:flex; gap:8px; justify-content:flex-end; margin-top:20px; flex-wrap:wrap;">
                    <button class="btn btn--secondary btn--sm admin-only" id="btnEditPlayerModalAction" type="button">✏
                        Edit Pemain</button>
                    <button class="btn btn--danger btn--sm admin-only" id="btnDeletePlayerModalAction" type="button">🗑
                        Hapus Pemain</button>
                    <button class="btn btn--secondary btn--sm" id="btnClosePlayerStatsBtn" type="button">Tutup</button>
                </div>
            </div>
        </div>

        <!-- ── Modal 7: Edit Player Modal ── -->
        <div class="modal-overlay" id="editPlayerModal" style="display:none;">
            <div class="modal-content">
                <div class="modal-header">
                    <h3>✏ Edit Data Pemain</h3>
                    <button class="modal-close-btn" id="btnCloseEditPlayerModal" aria-label="Close">&times;</button>
                </div>
                <form id="editPlayerForm">
                    <input type="hidden" id="editPlayerOldUsername">
                    <div class="form-group">
                        <label class="form-label" for="editPlayerUsername">Username</label>
                        <input type="text" class="form-input" id="editPlayerUsername" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="editPlayerRating">Rating</label>
                        <input type="number" class="form-input" id="editPlayerRating" required min="100" max="3000">
                    </div>
                    <div style="display:flex; gap:10px; justify-content:flex-end;">
                        <button type="button" class="btn btn--secondary" id="btnCancelEditPlayer">Batal</button>
                        <button type="submit" class="btn btn--primary" id="btnSavePlayer">Simpan Perubahan</button>
                    </div>
                </form>

                <div class="vrchat-link-section">
                    <label class="form-label">Akun VRChat</label>
                    <div class="vrchat-link-status" id="vrchatLinkStatus"></div>
                    <div class="vrchat-search-row">
                        <input type="text" class="form-input" id="vrchatSearchInput" placeholder="Cari nama VRChat...">
                        <button type="button" class="btn btn--secondary btn--sm" id="btnVrchatSearch">🔍 Cari</button>
                    </div>
                    <div class="vrchat-search-results" id="vrchatSearchResults"></div>
                </div>
            </div>
        </div>

        <!-- ── Modal 8: Edit Match Modal ── -->
        <div class="modal-overlay" id="editMatchModal" style="display:none;">
            <div class="modal-content">
                <div class="modal-header">
                    <h3>✏ Edit Pertandingan #<span id="editMatchIdTitle"></span></h3>
                    <button class="modal-close-btn" id="btnCloseEditMatchModal" aria-label="Close">&times;</button>
                </div>
                <form id="editMatchForm">
                    <input type="hidden" id="editMatchId">
                    <div class="form-group">
                        <label class="form-label" for="editMatchResult">Hasil Pertandingan</label>
                        <select class="form-select" id="editMatchResult" required>
                            <option value="1-0">1 - 0 (Putih Menang)</option>
                            <option value="1/2-1/2">½ - ½ (Remis)</option>
                            <option value="0-1">0 - 1 (Hitam Menang)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="editMatchUrl">URL Analisis</label>
                        <input type="url" class="form-input" id="editMatchUrl"
                            placeholder="https://lichess.org/analysis...">
                    </div>
                    <div style="display:flex; gap:10px; justify-content:flex-end;">
                        <button type="button" class="btn btn--secondary" id="btnCancelEditMatch">Batal</button>
                        <button type="submit" class="btn btn--primary" id="btnSaveMatch">Simpan &amp; Hitung Ulang
                            Rating</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ── Toast Container ── -->
        <div class="toast-container" id="toastContainer"></div>

        <!-- ── JavaScript Application ──
             app.js is a plain static asset (not Twig-processed), so any
             asset URL it needs that AssetMapper might hash in production
             has to be resolved here and handed over as a global instead of
             hardcoded in the JS. -->
        <script>
            window.OPENINGS_DB_URL = "{{ asset('data/openings_fen.json') }}";
        </script>
        <script src="{{ asset('app.js') }}"></script>

        <!-- Chess libs moved to <head> -->
    </body>

</html>