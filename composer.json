{
    "name": "cvar1984/chess",
    "description": "Chess Microservices",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "mongodb/mongodb": "^2.1",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "6.4.*",
        "symfony/runtime": "6.4.*",
        "symfony/console": "6.4.*",
        "doctrine/mongodb-odm-bundle": "^5.6",
        "symfony/yaml": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/security-bundle": "6.4.*",
        "symfony/http-client": "6.4.*",
        "symfony/process": "6.4.*",
        "symfony/twig-bundle": "6.4.*",
        "symfony/asset-mapper": "6.4.*",
        "symfony/asset": "6.4.*"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "VRchessIndo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VRchessIndo\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Cvar1984",
            "email": "cvar1984@cvar1984.net"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.1.99"
        }
    },
    "extra": {
        "symfony": {
            "require": "6.4.*"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/browser-kit": "6.4.*",
        "symfony/css-selector": "6.4.*"
    }
}
