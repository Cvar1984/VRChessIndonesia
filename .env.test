# define your env variables for the test env here
KERNEL_CLASS='VRchessIndo\Kernel'
APP_SECRET='$ecretf0rt3st'

# Dedicated test database on the same Atlas cluster as MONGODB_URI (see
# .env) — never the live "vrchessindo" database. MatchManagerTest's setUp()
# wipes this database's collections before every test, and asserts this
# exact name before doing so as a hard safety guard.
MONGODB_DB=vrchessindo_test

# VRChatClientTest/VRChatControllerTest construct real VRChatClient
# instances against a mocked HttpClient (see services.yaml's when@test:
# block) — no real network call ever happens, but VRChatClient's own
# self-imposed rate-limit throttle sleeps based on wall-clock time
# regardless of whether the HTTP client is mocked. Disabled here so the
# suite doesn't pay real seconds of sleep for a limit that only matters
# against the real api.vrchat.cloud.
VRCHAT_RATE_LIMIT_SECONDS=0

# Every VRCHAT_* env var below is #[Autowire(env: ...)]-bound somewhere
# (VRChatClientFactory, GalleryController, NewsletterController) — the
# container throws EnvNotFoundException at boot if any of them are
# genuinely undefined, not just falsy. Locally this was silently masked by
# the real (gitignored) .env always supplying real values underneath; a
# fresh checkout with no .env at all (a CI runner, or a fresh clone before
# `cp example.env .env`) has nothing to fall back on. VRCHAT_USERNAME/
# PASSWORD specifically must be non-empty strings — VRChatClient's own
# constructor guard throws on blank, and VRChatControllerTest exercises the
# real VRChatClientFactory service (only the HTTP layer is mocked) — but
# the actual values are never used for real authentication in test env, so
# any placeholder works.
VRCHAT_USERNAME=ci-test-user
VRCHAT_PASSWORD=ci-test-pass
VRCHAT_TOTP_SECRET=
VRCHAT_CONTACT=
VRCHAT_GROUP_ID=
VRCHAT_GROUP_GALLERY_ID=
