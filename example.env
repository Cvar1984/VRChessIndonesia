# Generated by MongoDB Atlas onboarding.
# This file contains sensitive credentials.
# DO NOT commit this file to version control.
# Store it securely (e.g. use a password manager or secrets vault).

MONGODB_USERNAME="user"
MONGODB_PASSWORD="pass"
MONGODB_URI="mongodb+srv://user:pass@cluster0.ca3fsz0.mongodb.net"

ADMIN_PASSWORD="admin"

# VRChat API (optional — powers cached profile pictures on the leaderboard).
# Use a VRChat account dedicated to this app, with Authenticator App (TOTP)
# 2FA enabled on it (email-code 2FA can't be completed unattended). Leave
# these blank to disable the feature — the leaderboard just falls back to
# generated initials avatars.
VRCHAT_USERNAME=""
VRCHAT_PASSWORD=""
VRCHAT_TOTP_SECRET=""
# Optional contact info appended to the API User-Agent VRChat requires.
VRCHAT_CONTACT=""
# Powers the /gallery page's photos, pulled live from your VRChat group's
# gallery/galleries (https://vrchat.community/reference/get-group-gallery-images).
# VRCHAT_GROUP_ID is required for the page to show anything. Leave
# VRCHAT_GROUP_GALLERY_ID blank to pull every approved photo from every
# gallery the group has; set it to one gallery's ID to show only that one.
VRCHAT_GROUP_ID=""
VRCHAT_GROUP_GALLERY_ID=""
# Minimum seconds between our own outbound requests to VRChat's API (self-
# imposed, since VRChat's unofficial API publishes no rate limit numbers but
# is known to temporarily block accounts that hammer it). Bump to 5 if you
# see VRChat-side errors; 0 disables throttling entirely.
VRCHAT_RATE_LIMIT_SECONDS="1"

###> symfony/framework-bundle ###
APP_ENV=dev
# Generate your own: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=""
###< symfony/framework-bundle ###

###> doctrine/mongodb-odm-bundle ###
# Reuses MONGODB_URI above — only the database name is separate, matching
# MongoDBDatabaseManager's existing hardcoded default.
MONGODB_DB=vrchessindo
###< doctrine/mongodb-odm-bundle ###

# Path to the Stockfish binary (legacy stockfish.php hardcoded this same path).
STOCKFISH_BINARY=/usr/bin/stockfish